# ===== 网络运维智能助手 · 环境变量示例 =====
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交到 GitHub）

# 智谱 AI 开放平台 API Key（https://open.bigmodel.cn，控制台-API Keys 中创建）
ZHIPU_API_KEY=

# 使用的 GLM 模型（默认 glm-4-flash，免费/低价，适合开发调试；可换 glm-4-air / glm-4-plus 等）
ZHIPU_MODEL=glm-4-flash

# 嵌入模型（RAG 向量化）
ZHIPU_EMBEDDING_MODEL=embedding-3

# 智谱 API 地址（OpenAI 兼容协议）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 未配置 Key 时：true 走模拟回复（方便调试前端/流式链路）；false 则必须配置 Key
LLM_MOCK=false

# 设备接入模式：simulate=内置仿真设备（默认，无需真实设备）；real=Netmiko SSH 连接 EVE-NG 仿真设备
# DEVICE_MODE=simulate
# 仿真故障场景（仅 simulate 模式）：flapping（链路质量）/ stp_loop（二层环路）/ arp_poison（ARP异常）/ bgp_flap（BGP抖动）/ acl_deny（ACL拦截）
# 启动后可用 POST /api/sim/scenario 运行时切换（admin）
# SIM_FAULT_SCENARIO=flapping

# ---- 安全层（M4）----
# 认证：true 时要求请求头 Authorization: Bearer <token>，角色由 API_TOKENS 决定；
# false（默认，本地演示）时信任所有调用按 admin 处理，入库/设备等全能力可用
# AUTH_ENABLED=false
# Token→角色映射（JSON）：{"<token>":"viewer","<token2>":"operator","<token3>":"admin"}
# API_TOKENS={"demo-viewer-token":"viewer","demo-operator-token":"operator","demo-admin-token":"admin"}

# /api/chat 每 IP 每分钟上限
# RATE_LIMIT_PER_MIN=30

# 审计日志（写入 backend/data/audit.jsonl）
# AUDIT_ENABLED=true

# ---- 混合检索（M4）----
# 是否启用智谱 rerank 精排（未配置 Key 时自动跳过）
# RERANK_ENABLED=true
